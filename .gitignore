# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量（含 API Key / 账号密码，严禁提交）
.env
.env.local
.env.*.local
!.env.example

# Playwright 会话状态（含登录 cookies，严禁提交）
.playwright-state/
playwright-user-data/
auth-state.json
*.storageState.json

# 浏览器下载的渲染成品（文件大，用 Git LFS 或外部存储）
assets/renders/
assets/downloads/
*.mp4
*.mov
*.webm
!assets/samples/*.mp4
!assets/samples/*.mov

# 本地 Claude 工作缓存
.claude/cache/
.claude/tmp/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 系统/临时
*.log
*.tmp
tmp/
scratch/

# Playwright 报告/截图（调试用，不入库）
test-results/
playwright-report/
blob-report/
playwright/.cache/
