# ============================================================
# 环境变量模板（复制为 .env 后填写真实值，.env 已在 .gitignore）
# 规则：
#   - 任何密钥/密码/Token 都走这里，不要写进代码或 commit
#   - 不同平台的账号分组，用前缀区分
#   - 所有平台都支持"扫码/人工登录 + 保存 cookies"模式，密钥是可选的
# ============================================================

# ---------- 视频生成平台 ----------

# Higgsfield (Seedance 2.0)
HIGGSFIELD_EMAIL=
HIGGSFIELD_PASSWORD=
HIGGSFIELD_LOGIN_MODE=interactive   # interactive=弹窗扫码 | password=密码登录

# Runway (Gen-3 / Gen-4)
RUNWAY_EMAIL=
RUNWAY_PASSWORD=
RUNWAY_API_KEY=                      # 可选：如果走 API

# Kling AI (可灵)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Luma AI (Dream Machine / Ray 2)
LUMA_API_KEY=

# OpenAI Sora (若有内测资格)
OPENAI_API_KEY=

# ---------- 辅助服务 ----------

# 对象存储（批量渲染时保存成品）
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# 飞书/钉钉 webhook（通知渲染完成）
NOTIFY_WEBHOOK_URL=

# ---------- 开发开关 ----------

# 是否允许 Claude 自动执行扣积分操作（默认 false，需人工确认）
ALLOW_PAID_OPERATIONS=false

# Playwright 是否 headless（本地调试建议 false）
PLAYWRIGHT_HEADLESS=false

# 日志级别
LOG_LEVEL=info
